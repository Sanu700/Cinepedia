
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the Cinepedia application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "creationTimestamp": {
          "type": "string",
          "description": "Timestamp of when the user account was created.",
          "format": "date-time"
        },
        "isEmailVerified": {
          "type": "boolean",
          "description": "Indicates whether the user has verified their email address."
        },
        "trustScore": {
          "type": "number",
          "description": "A score representing the user's trustworthiness based on account age and review history."
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "creationTimestamp",
        "isEmailVerified"
      ]
    },
    "Movie": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Movie",
      "type": "object",
      "description": "Represents a movie in the Cinepedia application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Movie entity."
        },
        "title": {
          "type": "string",
          "description": "Title of the movie."
        },
        "synopsis": {
          "type": "string",
          "description": "Synopsis or summary of the movie's plot."
        },
        "genre": {
          "type": "string",
          "description": "Genre of the movie."
        },
        "releaseDate": {
          "type": "string",
          "description": "Release date of the movie.",
          "format": "date-time"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the movie's poster image.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "title",
        "synopsis",
        "genre",
        "releaseDate",
        "imageUrl"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Review",
      "type": "object",
      "description": "Represents a user's review of a movie.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Review entity."
        },
        "movieId": {
          "type": "string",
          "description": "Reference to Movie. (Relationship: Movie 1:N Review)"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Review)"
        },
        "rating": {
          "type": "number",
          "description": "Rating given by the user (1-5)."
        },
        "reviewText": {
          "type": "string",
          "description": "Text content of the review."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of when the review was submitted.",
          "format": "date-time"
        },
        "likes": {
          "type": "number",
          "description": "The number of likes the review has received."
        },
        "hasSpoiler": {
            "type": "boolean",
            "description": "Indicates whether the review contains spoilers."
        }
      },
      "required": [
        "id",
        "movieId",
        "userId",
        "rating",
        "reviewText",
        "timestamp"
      ]
    },
    "Poll": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Poll",
      "type": "object",
      "description": "Represents a movie poll where users can vote between two movies.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Poll entity."
        },
        "movie1Id": {
          "type": "string",
          "description": "Reference to Movie. First movie in the poll."
        },
        "movie2Id": {
          "type": "string",
          "description": "Reference to Movie. Second movie in the poll."
        },
        "startTime": {
          "type": "string",
          "description": "Timestamp of when the poll started.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "Timestamp of when the poll ends.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "movie1Id",
        "movie2Id",
        "startTime",
        "endTime"
      ]
    },
    "Vote": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vote",
      "type": "object",
      "description": "Represents a user's vote in a movie poll.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Vote entity."
        },
        "pollId": {
          "type": "string",
          "description": "Reference to Poll. (Relationship: Poll 1:N Vote)"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Vote)"
        },
        "movieId": {
          "type": "string",
          "description": "Reference to Movie. The movie the user voted for."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of when the vote was cast.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "pollId",
        "userId",
        "movieId",
        "timestamp"
      ]
    },
    "Streak": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Streak",
      "type": "object",
      "description": "Tracks a user's consecutive daily activity streak.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user this streak belongs to."
        },
        "currentStreak": {
          "type": "number",
          "description": "The current number of consecutive days of activity."
        },
        "startDate": {
          "type": "string",
          "description": "The date the current streak began.",
          "format": "date-time"
        },
        "lastActivityDate": {
          "type": "string",
          "description": "The date of the last recorded activity.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "currentStreak",
        "lastActivityDate"
      ]
    },
    "Admin": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Admin",
        "type": "object",
        "description": "Represents an administrator user role.",
        "properties": {
          "userId": {
            "type": "string",
            "description": "The UID of the user who is an admin."
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when admin rights were granted."
          }
        },
        "required": ["userId", "grantedAt"]
    },
    "SiteAnalytics": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Site Analytics",
        "type": "object",
        "description": "Stores aggregated analytics data for the entire site.",
        "properties": {
          "totalUsers": { "type": "number", "description": "Total number of registered users." },
          "totalReviews": { "type": "number", "description": "Total number of reviews submitted." },
          "totalVotes": { "type": "number", "description": "Total number of votes cast in polls." },
          "dailySignups": {
            "type": "object",
            "description": "A map of dates to the number of new user signups on that day.",
            "additionalProperties": { "type": "number" }
          }
        },
        "required": ["totalUsers", "totalReviews", "totalVotes"]
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "Stores user profiles." }
      },
      {
        "path": "/movies/{movieId}",
        "definition": { "entityName": "Movie", "schema": { "$ref": "#/backend/entities/Movie" }, "description": "Stores movie information." }
      },
      {
        "path": "/reviews/{reviewId}",
        "definition": { "entityName": "Review", "schema": { "$ref": "#/backend/entities/Review" }, "description": "Stores movie reviews." }
      },
      {
        "path": "/polls/{pollId}",
        "definition": { "entityName": "Poll", "schema": { "$ref": "#/backend/entities/Poll" }, "description": "Stores movie poll information." }
      },
      {
        "path": "/polls/{pollId}/votes/{voteId}",
        "definition": { "entityName": "Vote", "schema": { "$ref": "#/backend/entities/Vote" }, "description": "Stores votes for a movie poll." }
      },
      {
        "path": "/streaks/{userId}",
        "definition": { "entityName": "Streak", "schema": { "$ref": "#/backend/entities/Streak" }, "description": "Stores user activity streaks." }
      },
      {
        "path": "/admins/{userId}",
        "definition": { "entityName": "Admin", "schema": { "$ref": "#/backend/entities/Admin" }, "description": "A list of user UIDs with admin privileges." }
      },
      {
        "path": "/analytics/stats",
        "definition": { "entityName": "SiteAnalytics", "schema": { "$ref": "#/backend/entities/SiteAnalytics" }, "description": "A single document to hold site-wide aggregated statistics." }
      }
    ]
  }
}
